@using DatasetBuilder.Web.Models
<MudPaper Class="pa-2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.h6">Filters</MudText>
        <MudButton Variant="Variant.Filled" OnClick="AddFilter">Add Filter</MudButton>
    </MudStack>

    @foreach (var rule in State.FilterRules)
    {
        <MudGrid>
            <MudItem xs="4"><MudTextField Value="@rule.ColumnName" ValueChanged="@(v => Update(rule, rule with { ColumnName = v }))" Label="Column" /></MudItem>
            <MudItem xs="3"><MudSelect T="string" Value="@rule.Operator" ValueChanged="@(v => Update(rule, rule with { Operator = v }))"><MudSelectItem Value="=">=</MudSelectItem><MudSelectItem Value=">">&gt;</MudSelectItem><MudSelectItem Value="<">&lt;</MudSelectItem><MudSelectItem Value="LIKE">LIKE</MudSelectItem></MudSelect></MudItem>
            <MudItem xs="4"><MudTextField Value="@rule.Value" ValueChanged="@(v => Update(rule, rule with { Value = v }))" Label="Value" /></MudItem>
        </MudGrid>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public DatasetBuilderState State { get; set; } = new();
    private void AddFilter() => State.FilterRules.Add(new FilterRuleVm(string.Empty, "=", string.Empty));
    private void Update(FilterRuleVm oldRule, FilterRuleVm newRule)
    {
        State.FilterRules.Remove(oldRule);
        State.FilterRules.Add(newRule);
    }
}
